# WonderPress specific
/vendor
node_modules

# wp-env (Docker). The container writes wp-cli.yml and the debug log into the
# project; .htaccess and wp-config.php are already covered below.
# .wp-env.override.json is the per-developer escape hatch — wp-env merges it
# over .wp-env.json, so a locally-bumped port never shows up in a diff.
.wp-env.override.json
wp-cli.yml
wp-content/debug.log

# Misc extensions
wp*~
.DS_Store
.svn
.cvs
*.bak
*.swp
Thumbs.db
.htaccess
package-lock.json
!/package-lock.json
composer.lock

# The theme is a self-contained deployable unit: it carries its own Composer
# manifest, lock file and vendor directory so a deploy needs no Composer step.
# `composer.lock` above is unanchored and would otherwise swallow the theme's,
# taking reproducibility with it. `/vendor` above is root-anchored and does not
# reach the theme, so the theme's vendor directory is committed by default.
!/wp-content/themes/*/composer.lock

