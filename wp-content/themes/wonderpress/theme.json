{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "slug": "white", "color": "#ffffff", "name": "White" },
				{ "slug": "black", "color": "#000000", "name": "Black" },
				{ "slug": "blue", "color": "#7a97ab", "name": "Blue" },
				{ "slug": "dark-blue", "color": "#415364", "name": "Dark Blue" },
				{ "slug": "light-blue", "color": "#aabbc7", "name": "Light Blue" },
				{ "slug": "grey", "color": "#d1d3d4", "name": "Grey" },
				{ "slug": "light-grey", "color": "#f1f2f2", "name": "Light Grey" },
				{ "slug": "orange", "color": "#ff6b00", "name": "Orange" },
				{ "slug": "red", "color": "#ff0000", "name": "Red" },
				{ "slug": "lighter-orange", "color": "#f68b53", "name": "Lighter Orange" },
				{ "slug": "accent", "color": "#ff6b00", "name": "Accent" },
				{ "slug": "base", "color": "#ffffff", "name": "Base" },
				{ "slug": "contrast", "color": "#000000", "name": "Contrast" }
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"fluid": true,
			"lineHeight": true,
			"fontFamilies": [
				{
					"slug": "sans-serif",
					"name": "Sans Serif",
					"fontFamily": "\"Open Sans\", sans-serif"
				},
				{
					"slug": "serif",
					"name": "Serif",
					"fontFamily": "serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "medium", "name": "Medium", "size": "1rem" },
				{ "slug": "large", "name": "Large", "size": "1.5rem" },
				{ "slug": "x-large", "name": "Extra Large", "size": "2.25rem" }
			]
		},
		"spacing": {
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"padding": true,
			"margin": true,
			"blockGap": true,
			"units": ["rem", "%", "vw"],
			"spacingSizes": [
				{ "slug": "20", "name": "1", "size": "0.5rem" },
				{ "slug": "30", "name": "2", "size": "1rem" },
				{ "slug": "40", "name": "3", "size": "1.5rem" },
				{ "slug": "50", "name": "4", "size": "2.5rem" },
				{ "slug": "60", "name": "5", "size": "4rem" }
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": false
		},
		"custom": {
			"color": {
				"error": "#f03d3e",
				"success": "#25c274"
			},
			"type": {
				"paragraph": {
					"size": "1rem",
					"lh": "1.5625",
					"weight": "400"
				},
				"eyebrow": {
					"size": "0.875rem",
					"lh": "1.0714",
					"weight": "500",
					"tracking": "0.96px",
					"trackingLaptop": "1.12px"
				},
				"headline": {
					"weight": "600"
				},
				"title": {
					"size": "2rem",
					"lh": "1.1875",
					"weight": "700",
					"tracking": "-0.015em",
					"sizeTablet": "4.5rem",
					"lhTablet": "1.1111"
				},
				"h1": {
					"size": "2.25rem",
					"lh": "1.1111",
					"sizeTablet": "4rem",
					"lhTablet": "1.125"
				},
				"h2": {
					"size": "1.5rem",
					"lh": "1.25",
					"tracking": "-0.005em",
					"sizeTablet": "3rem",
					"lhTablet": "1",
					"trackingTablet": "-0.72px"
				},
				"h3": {
					"size": "1.5rem",
					"lh": "1.25",
					"sizeTablet": "2rem",
					"lhTablet": "1.125",
					"trackingTablet": "-0.32px"
				},
				"h4": {
					"size": "1.125rem",
					"lh": "1.3333",
					"tracking": "-0.01em",
					"sizeTablet": "1.75rem",
					"lhTablet": "1.1429",
					"trackingTablet": "-0.14px"
				},
				"h5": {
					"size": "1rem",
					"lh": "1.375",
					"tracking": "-0.01em",
					"sizeTablet": "1.125rem",
					"lhTablet": "1.2222"
				},
				"h6": {
					"size": "0.875rem",
					"lh": "1.4286",
					"tracking": "-0.01em",
					"sizeTablet": "1rem",
					"lhTablet": "1.25"
				}
			}
		}
	},
	"styles": {}
}
