{
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.1"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "./vendor/bin/phpcs -p -v wp-content/themes/.",
        "lint-fix": "./vendor/bin/phpcbf -p -v wp-content/themes/.",
        "post-update-cmd": [
            "./vendor/bin/phpcs -i"
        ]
    }
}
